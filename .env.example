# Copy to .env (gitignored) to override docker-compose.yml's / Makefile's
# credential defaults for this local lab. The values below are Wazuh's own
# published stock single-node demo credentials -- not secrets, not unique to
# this project, not protecting anything real. Left unset (no .env file),
# everything falls back to these same values, so the lab keeps working
# exactly as before.
#
# IMPORTANT: WAZUH_INDEXER_PASSWORD is coupled to the bcrypt hash for the
# `admin` user in wazuh/config/wazuh_indexer/internal_users.yml. Changing
# the password here WITHOUT regenerating that hash to match (plugin/tools/
# hash.sh, run inside the wazuh-indexer image) will break authentication
# between wazuh.manager and wazuh.indexer. Do not change one without the
# other. See docker-compose.yml's own comment for the full explanation.

WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=pYe/NaFfPWYuWIUxIWf0X5XdDigqQmcd
